TS_AUTHKEY=tskey-auth-xxxxx

# Optional: gates POST /api/training/start|stop, /api/training/config,
# /api/simulate/start|stop, and /api/tests/run behind an X-API-Token header.
# Leave unset for local single-user use (matches prior behavior). If set,
# visit the Train/Simulate pages once per device as e.g.
# http://mushibot:5000/train?api_token=<value> to save it to that browser.
MUSHIBOT_API_TOKEN=

# Postgres connection for the site's persistence layer (Phase 2). Compose
# fills this in automatically for the containerized backend - only needed
# here for running the app or its DB tests directly on the host.
# POSTGRES_PASSWORD defaults to "mushibot" if unset (see docker-compose.yml).

# A *disposable* database for tests/test_db.py - never point this at the
# `createdb -h localhost -U mushibot mushibot_test` is enough locally.
