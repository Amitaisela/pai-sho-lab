TS_AUTHKEY=tskey-auth-xxxxx

# MANDATORY for the Lab under docker compose (compose refuses to start the lab
# service without it). Gates POST /api/training/start|stop, /api/training/config,
# /api/simulate/start|stop, and /api/tests/run behind an X-API-Token header.
# Visit the Train/Simulate pages once per device as e.g.
# http://mushibot:5001/train?api_token=<value> to save it to that browser.
# (Running backend/ui/server.py directly on loopback may still leave it unset.)
MUSHIBOT_API_TOKEN=
